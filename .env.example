# ==========================================
# Upstash Redis Configuration
# Obtain from Upstash Console -> Redis -> Details -> REST API
# ==========================================
UPSTASH_REDIS_REST_URL=https://your-redis-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_rest_token_here

# ==========================================
# Upstash Vector Configuration
# Obtain from Upstash Console -> Vector -> Details -> REST API
# ==========================================
UPSTASH_VECTOR_REST_URL=https://your-vector-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_vector_rest_token_here

# ==========================================
# Upstash QStash Configuration
# Obtain from Upstash Console -> QStash -> Details / Keys
# ==========================================
QSTASH_TOKEN=your_qstash_token_here
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key_here
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key_here

